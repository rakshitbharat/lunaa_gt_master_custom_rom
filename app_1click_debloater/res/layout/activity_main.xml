<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ 1-Click Debloater &amp; Privacy"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tv_device_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Realme GT Master • Android 16"
        android:textSize="13sp"
        android:textColor="#A0A0A0" />

    <!-- Status row with two badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="#1E293B"
            android:text="Admin: Active"
            android:textSize="12sp"
            android:textColor="#00E676" />

        <TextView
            android:id="@+id/tv_gapps_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="#1E293B"
            android:text="Google: Unknown"
            android:textSize="12sp"
            android:textColor="#38BDF8" />
    </LinearLayout>

    <!-- SECTION 1: GOOGLE PLAY & PRIVACY CONTROLS -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="GOOGLE SERVICES &amp; PRIVACY MODES"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#94A3B8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btn_minimal_gapps"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🟢 MINIMAL PLAY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="#00E676" />

        <Button
            android:id="@+id/btn_degoogle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="🚫 100% GOOGLE-FREE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#7C3AED" />
    </LinearLayout>

    <!-- SECTION 2: SYSTEM DEBLOATER -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="SYSTEM SUITE CONTROLS"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#94A3B8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btn_debloat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="⚡ PURGE BLOAT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="#38BDF8" />

        <Button
            android:id="@+id/btn_restore"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="🔄 RESTORE ALL"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#334155" />
    </LinearLayout>

    <!-- SECTION 3: DEVICE ADMIN RELEASE -->
    <Button
        android:id="@+id/btn_release_admin"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:text="🔓 RELEASE DEVICE OWNER (UNMANAGE)"
        android:textSize="11sp"
        android:textColor="#FCA5A5"
        android:background="#450A0A" />

    <!-- Terminal Output Log -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ACTION LOG"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#64748B" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="#0A0A0A"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Ready.\n• Tap '🟢 MINIMAL PLAY' for bare-bones Play Store with 0 bloatware.\n• Tap '🚫 100% GOOGLE-FREE' to completely purge all Google services.\n"
            android:textSize="11sp"
            android:textColor="#A7F3D0" />
    </ScrollView>

</LinearLayout>
