<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ 1-Click Debloater"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tv_device_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Realme GT Master • Android 16"
        android:textSize="14sp"
        android:textColor="#A0A0A0" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#1E293B"
        android:text="Status: Ready"
        android:textSize="13sp"
        android:textColor="#38BDF8" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btn_debloat"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:text="⚡ DEBLOAT ENTIRE PHONE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:background="#00E676" />

    <Button
        android:id="@+id/btn_restore"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="🔄 RESTORE UNINSTALLED APPS"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="#334155" />

    <Button
        android:id="@+id/btn_release_admin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="🔓 RELEASE DEVICE OWNER (UNMANAGE)"
        android:textSize="13sp"
        android:textColor="#FCA5A5"
        android:background="#450A0A" />

    <!-- Terminal Output Log -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="ACTION LOG"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#64748B" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#0A0A0A"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Ready to clean.\nTap 'DEBLOAT ENTIRE PHONE' to strip all telemetry and unneeded consumer bloatware.\n"
            android:textSize="12sp"
            android:textColor="#A7F3D0" />
    </ScrollView>

</LinearLayout>
